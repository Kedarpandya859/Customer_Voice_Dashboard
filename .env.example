# Copy this file to .env and fill in your real values. Never commit .env.

# Get this from Supabase: Project Settings -> Database -> Connect ->
# Direct connection tile -> switch to "Session pooler" -> copy the URI.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Apps to analyze, separated by ";". Each entry is  Name|play.store.id|domain
#   Name    - shown in the dashboard and stored in the DB
#   id      - from the Play Store URL: play.google.com/store/apps/details?id=THIS_PART
#   domain  - which complaint taxonomy to use: "ecommerce" or "fintech"
#             (add more in TAXONOMIES in src/config.py)
TARGET_APPS=Meesho|com.meesho.supply|ecommerce;Paytm|net.one97.paytm|fintech

# Legacy single-app settings - only used if TARGET_APPS is not set.
# TARGET_APP_ID=com.meesho.supply

# TARGET_COMPANY_NAME=Meesho

# --- LLM provider for the tagging + opportunity steps ---
# "gemini" = free, no credit card (recommended). "anthropic" = paid, needs credits.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Free key from aistudio.google.com -> Get API key. Needed if LLM_PROVIDER=gemini.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# From console.anthropic.com. Only needed if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
